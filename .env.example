# Application Configuration
APP_NAME=AlphaHunterAI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Database Configuration
DATABASE_URL=duckdb:///data/alphahunter.db
DATABASE_ECHO=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/alphahunter.log

# External API Keys (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Data Sources
# SCREENER_API_KEY=your_screener_api_key_here
# MONEYCONTROL_API_KEY=your_moneycontrol_api_key_here

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Security
SECRET_KEY=your_secret_key_here_change_in_production
